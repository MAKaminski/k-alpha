# Schwab API Credentials (use either naming convention)
SCHWAB_API_KEY=your_schwab_api_key
SCHWAB_API_SECRET=your_schwab_api_secret
SCHWAB_CALLBACK_URL=https://127.0.0.1

# Schwab Tokens (for Railway/production only - generated by running "npm run auth" locally)
# Run "npm run export-tokens" to get the value for this variable
# SCHWAB_TOKENS={"access_token":"...","refresh_token":"...","expires_at":...}

# Supabase Credentials
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_service_key

