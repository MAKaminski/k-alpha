# Schwab API Credentials (use either naming convention)
SCHWAB_API_KEY=your_schwab_api_key
SCHWAB_API_SECRET=your_schwab_api_secret
SCHWAB_CALLBACK_URL=https://127.0.0.1

# Paper Trading Configuration
SCHWAB_PAPER=true
SCHWAB_PAPER_API_KEY=your_paper_trading_api_key
SCHWAB_PAPER_API_SECRET=your_paper_trading_api_secret
SCHWAB_PAPER_ACCOUNT_ID=8042-3452

# Schwab Tokens (for Railway/production only - generated by running "npm run auth" locally)
# Run "npm run export-tokens" to get the value for this variable
# SCHWAB_TOKENS={"access_token":"...","refresh_token":"...","expires_at":...}

# Paper Trading Tokens (for Railway/production only - generated by running "npm run auth" locally with paper credentials)
# SCHWAB_PAPER_TOKENS={"access_token":"...","refresh_token":"...","expires_at":...}

# Supabase Credentials
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_service_key

